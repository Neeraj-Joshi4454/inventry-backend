NODE_ENV=development
PORT=4000

# Must point at a replica-set-enabled MongoDB (required for multi-document transactions).
# Local dev: run mongod as a single-node replica set, or use MongoDB Atlas (RS by default).
MONGODB_URI=mongodb://127.0.0.1:27017/inventry?replicaSet=rs0

JWT_ACCESS_SECRET=change-me-access-secret
# Refresh tokens are opaque (not JWTs) — this secret is used as the HMAC key
# that hashes each refresh token's validator before it's stored, and to set
# how long a refresh session lives (JWT_REFRESH_EXPIRES_IN).
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional — defaults shown. PASSWORD_MIN_LENGTH keeps the password policy
# configurable (src/utils/passwordPolicy.ts). The rate-limit overrides exist
# so the test suite can raise ceilings that would otherwise trip from normal
# test volume — never set these away from their defaults in production.
# PASSWORD_MIN_LENGTH=8
# AUTH_RATE_LIMIT_MAX=10
# GLOBAL_RATE_LIMIT_MAX=300

# Comma-separated allowlist. Only browser clients (the Next.js admin) need
# CORS — the Flutter app is not a browser and is unaffected by this setting.
# Never "*" in production.
CORS_ORIGIN=http://localhost:3000

# Used only by scripts/bootstrapSuperAdmin.ts
SUPER_ADMIN_MOBILE=9999999999
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin
